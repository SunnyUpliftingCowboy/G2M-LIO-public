<launch>
  <!-- Launch file -->

    <arg name="rviz" default="true" />
    <arg name="consistency_log_enable" default="false" />
    <arg name="consistency_file_path" default="$(find g2m_lio)/Log/consistency.csv" />
    <arg name="traj_log_file" default="$(find g2m_lio)/Log/traj.txt" />

    <rosparam command="load" file="$(find g2m_lio)/config/avia.yaml" />

    <param name="runtime_pos_log_enable" type="bool" value="0" />
    <param name="consistency_log_enable" type="bool" value="$(arg consistency_log_enable)" />
    <param name="consistency_file_path" type="string" value="$(arg consistency_file_path)" />
    <node pkg="g2m_lio" type="run_mapping_online" name="laserMapping" output="screen"
          args="--traj_log_file=$(arg traj_log_file)" />

    <group if="$(arg rviz)">
      <node launch-prefix="nice" pkg="rviz" type="rviz" name="ivox_rviz" args="-d $(find g2m_lio)/rviz_cfg/loam.rviz" />
    </group>

</launch>
